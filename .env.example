# ──────────────────────────────────────────────
# MFScope — Environment Variables
# Copy to .env and fill in real values.
# Never commit .env to version control.
# ──────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mfscope
# For local SQLite MVP, swap to:
# DATABASE_URL=sqlite+aiosqlite:///./mfscope.db

# FastAPI
SECRET_KEY=change-me-to-a-random-64-char-string
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AMFI NAV feed (public, no key needed — left here as reference)
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
AMFI_SCHEME_URL=https://api.mfapi.in/mf

# News RSS feeds
ET_MARKETS_RSS=https://economictimes.indiatimes.com/markets/rss
MONEYCONTROL_RSS=https://www.moneycontrol.com/rss/MCtopnews.xml
LIVEMINT_RSS=https://www.livemint.com/rss/markets
BUSINESS_STANDARD_RSS=https://www.business-standard.com/rss/markets-106.rss

# NLP model (HuggingFace hub id or local path)
SENTIMENT_MODEL=ProsusAI/finbert
# Set to "vader" to use lightweight VADER instead of FinBERT
SENTIMENT_BACKEND=finbert

# Scheduler intervals (seconds)
NAV_PULL_INTERVAL_SECONDS=86400
NEWS_PULL_INTERVAL_SECONDS=3600

# Logging
LOG_LEVEL=INFO
